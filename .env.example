# ===========================================================================
# BANCO DE DADOS (PostgreSQL)
#
# Escolha UMA das duas opcoes abaixo. Deixe a outra comentada.
#
# connection_limit e pool_timeout nao sao opcionais em nenhuma delas: o build
# gera dezenas de paginas estaticas em paralelo e, com o pool padrao do
# Prisma, as consultas estouram — o build termina "com sucesso" publicando
# paginas vazias.
# ===========================================================================

# --- OPCAO A: PostgreSQL local via Docker (docker compose up -d) ------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiainterativo?schema=public&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/guiainterativo?schema=public&connection_limit=5&pool_timeout=30"

# --- OPCAO B: Supabase -----------------------------------------------------
#
# Copie as strings prontas em:
#   Supabase -> Connect -> ORMs -> Prisma
#
# Use SEMPRE o pooler nas duas variaveis. O host direto
# (db.<ref>.supabase.co) resolve apenas em IPv6, e nem toda rede — nem as
# funcoes da Vercel — alcancam IPv6.
#
#   DATABASE_URL -> Transaction pooler, porta 6543
#                   exige ?pgbouncer=true&connection_limit=1
#                   (o pgBouncer em modo transaction nao suporta prepared
#                   statements; sem essa flag o Prisma quebra em runtime)
#
#   DIRECT_URL   -> Session pooler, porta 5432
#                   usado por prisma migrate / db push, que precisam de
#                   conexao real e nao passam pelo pgBouncer
#
# O usuario tem o formato postgres.<project-ref> e a regiao aparece no host
# (ex.: aws-0-sa-east-1 ou aws-1-sa-east-1). Copie exatamente o que o painel
# mostrar — a regiao e o numero do host variam por projeto.
#
# DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
#
# Se a senha tiver @ : / ? # & ou %, use percent-encoding
# (@ = %40, # = %23, & = %26, / = %2F, : = %3A, ? = %3F, % = %25).

# ---------------------------------------------------------------------------
# NextAuth.js
# Gere o secret com: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-secret-aleatorio-de-32-caracteres"

# ---------------------------------------------------------------------------
# Usuario administrador
#
# Nao existe ADMIN_PASSWORD, e isso e intencional.
#
# O seed gera uma senha aleatoria forte e a mostra uma unica vez no terminal.
# A senha vive apenas como hash bcrypt na tabela users — nunca em texto puro
# no disco. Para trocar depois:  npm run admin:password
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@guiainterativo.com"
ADMIN_NAME="Equipe Guia Interativo"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://guiainterativo.com"
NEXT_PUBLIC_SITE_NAME="Guia Interativo"

# ---------------------------------------------------------------------------
# Google Analytics 4 + Google AdSense
# Deixe vazio em desenvolvimento para nao poluir as metricas.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_ENABLED="false"

# ---------------------------------------------------------------------------
# Contato / WhatsApp (somente numeros, com DDI + DDD)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
NEXT_PUBLIC_CONTACT_EMAIL="contato@guiainterativo.com"

# ---------------------------------------------------------------------------
# Revalidacao sob demanda (ISR) — usado pelo painel admin
# ---------------------------------------------------------------------------
REVALIDATE_SECRET="troque-por-um-token-aleatorio"

# ---------------------------------------------------------------------------
# Supabase Storage — upload de imagens pelo painel
#
# A URL ja esta preenchida. Falta so a service_role key:
#   Supabase -> Settings -> API -> Project API keys -> service_role
#
# ATENCAO: a service_role ignora todas as regras de RLS. Ela e usada apenas
# no servidor (app/api/media/upload) e NUNCA deve receber o prefixo
# NEXT_PUBLIC_, que a exporia no navegador.
#
# O bucket "media" e criado automaticamente no primeiro upload.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Geracao de capas de post (Gemini / "nano banana") — opcional
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Opcional: force um modelo especifico. Veja os disponiveis com:
#   npm run capa:gerar -- --modelos
GEMINI_IMAGE_MODEL=""
